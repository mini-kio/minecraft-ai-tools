    "mct": "node bin/mct.mjs",
    "demo": "node examples/create-demo.mjs work/demo"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "express": "^5.3.0",
    "minecraft-data": "^3.100.0",
    "mineflayer": "^4.33.0",
    "mineflayer-pathfinder": "^2.4.5",
    "playwright": "^1.56.0",
    "pngjs": "^7.0.0",
    "prismarine-block": "^1.22.0",
    "prismarine-chunk": "^1.39.0",
    "prismarine-nbt": "^2.7.0",
    "prismarine-provider-anvil": "^2.10.0",
    "prismarine-schematic": "^1.3.0",
    "prismarine-viewer": "^1.33.0",
    "prismarine-world": "^3.6.0",
    "rcon-client": "^4.2.5",
    "socket.io": "^4.8.4",
    "three": "^0.180.0",
    "vec3": "^0.1.10",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.25.0"

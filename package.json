{
  "name": "minecraft-ai-tools",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Minecraft observation, inspection and control tools for AI agents",
  "license": "MIT",
  "bin": {
    "mct": "bin/mct.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && tsx --test tests/*.test.ts",
